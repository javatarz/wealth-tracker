              {
                "enum": [
                  "file_too_large",
                  "already_imported",
                  "commit_failed"
                ],
                "type": "string"
              }
            ],
            "title": "Code"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "StatementError",
        "type": "object"
      },
      "StatementPeriod": {
        "properties": {
