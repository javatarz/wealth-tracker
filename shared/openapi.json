  "info": {
    "title": "Wealth Tracker",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/benchmarks/catalog": {
      "get": {
        "operationId": "listBenchmarks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BenchmarkDefinitionOut"
                  },
                  "title": "Response Listbenchmarks",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Catalog"
      }
    },
    "/api/benchmarks/config": {
      "get": {
        "operationId": "getBenchmarkConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkConfigOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config"
      }
    },
    "/api/benchmarks/config/{asset_class}": {
      "put": {
        "operationId": "setBenchmark",
        "parameters": [
          {
            "in": "path",
            "name": "asset_class",
            "required": true,
            "schema": {
              "enum": [
                "equity",
                "debt",
                "gold",
                "real_estate",
                "crypto",
                "cash",
                "other"
              ],
              "title": "Asset Class",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetClassBenchmarkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Benchmark"
      }
    },
    "/api/benchmarks/instruments": {
      "get": {
        "operationId": "listInstrumentBenchmarks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InstrumentBenchmarkOut"
                  },
                  "title": "Response Listinstrumentbenchmarks",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Instrument Benchmarks"
      }
    },
    "/api/benchmarks/instruments/{instrument_id}": {
      "put": {
        "operationId": "setInstrumentBenchmark",
        "parameters": [
          {
            "in": "path",
            "name": "instrument_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Instrument Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstrumentBenchmarkChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentBenchmarkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Instrument Benchmark"
      }
    },
    "/api/benchmarks/overlay": {
      "get": {
        "operationId": "getBenchmarkOverlay",
        "parameters": [
          {
            "in": "query",
            "name": "benchmark",
            "required": true,
            "schema": {
              "title": "Benchmark",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start_value",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "title": "Start Value"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date",
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date",
              "title": "To",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverlayOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Overlay"
