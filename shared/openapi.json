{
  "components": {
    "schemas": {
      "Action": {
        "enum": [
          "trust_ledger",
          "trust_statement",
          "leave_out"
        ],
        "title": "Action",
        "type": "string"
      },
      "Body_commitImport": {
        "properties": {
          "decisions": {
            "anyOf": [
              {
                "contentMediaType": "application/json",
                "contentSchema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/Action"
                  },
                  "type": "object"
                },
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "JSON object mapping each mismatch's holding to an Action",
            "title": "Decisions"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "CAMS/KFintech consolidated account statement",
            "title": "File",
            "type": "string"
          },
          "password": {
            "default": "",
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_commitImport",
        "type": "object"
      },
      "Body_previewStatement": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "CAMS/KFintech consolidated account statement",
            "title": "File",
            "type": "string"
          },
          "password": {
            "default": "",
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_previewStatement",
        "type": "object"
      },
      "DecisionsRequired": {
        "description": "Nothing was saved. Commit again with an Action for every mismatch.",
        "properties": {
          "mismatches": {
            "items": {
              "$ref": "#/components/schemas/Mismatch"
            },
            "title": "Mismatches",
            "type": "array"
          },
          "outcome": {
            "const": "needs_decisions",
            "title": "Outcome",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "mismatches"
        ],
        "title": "DecisionsRequired",
        "type": "object"
      },
      "Folio": {
        "properties": {
          "amc": {
            "title": "Amc",
            "type": "string"
          },
          "folio": {
            "title": "Folio",
            "type": "string"
          },
          "schemes": {
            "items": {
              "$ref": "#/components/schemas/Scheme"
            },
            "title": "Schemes",
            "type": "array"
          }
        },
        "required": [
          "folio",
          "amc",
          "schemes"
        ],
        "title": "Folio",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImportReceipt": {
        "properties": {
          "import_id": {
            "format": "uuid",
            "title": "Import Id",
            "type": "string"
          },
          "outcome": {
            "const": "committed",
            "title": "Outcome",
            "type": "string"
          },
          "positions": {
            "title": "Positions",
            "type": "integer"
          },
          "transactions": {
            "title": "Transactions",
            "type": "integer"
          }
        },
        "required": [
          "outcome",
          "import_id",
          "positions",
          "transactions"
        ],
        "title": "ImportReceipt",
        "type": "object"
      },
      "Mismatch": {
        "description": "A Scheme whose printed closing units differ from the units the ledger would derive.",
        "properties": {
          "delta": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Delta",
            "type": "string"
          },
          "derived_units": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Derived Units",
            "type": "string"
          },
          "folio": {
            "title": "Folio",
            "type": "string"
          },
          "holding": {
            "title": "Holding",
            "type": "string"
          },
          "institution": {
            "title": "Institution",
            "type": "string"
          },
          "printed_units": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Printed Units",
            "type": "string"
          },
          "scheme": {
            "title": "Scheme",
            "type": "string"
          }
        },
        "required": [
          "holding",
          "scheme",
          "institution",
          "folio",
          "printed_units",
          "derived_units",
          "delta"
        ],
        "title": "Mismatch",
        "type": "object"
      },
      "ParserInfo": {
        "properties": {
          "name": {
            "const": "casparser",
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ParserInfo",
        "type": "object"
      },
      "PositionSummary": {
        "properties": {
          "cost_basis": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Basis",
            "type": "string"
          },
          "folio": {
            "title": "Folio",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "institution": {
            "title": "Institution",
            "type": "string"
          },
          "scheme": {
            "title": "Scheme",
            "type": "string"
          },
          "units": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Units",
            "type": "string"
          }
        },
        "required": [
          "id",
          "scheme",
          "institution",
          "folio",
          "units",
          "cost_basis"
        ],
        "title": "PositionSummary",
        "type": "object"
      },
      "Scheme": {
        "properties": {
          "advisor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advisor"
          },
          "amfi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amfi"
          },
          "close": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Close",
            "type": "string"
          },
          "close_calculated": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Close Calculated",
            "type": "string"
          },
          "isin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isin"
          },
          "open": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Open",
            "type": "string"
          },
          "rta": {
            "title": "Rta",
            "type": "string"
          },
          "rta_code": {
            "title": "Rta Code",
            "type": "string"
          },
          "scheme": {
            "title": "Scheme",
            "type": "string"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "title": "Transactions",
            "type": "array"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "valuation": {
            "$ref": "#/components/schemas/Valuation"
          }
        },
        "required": [
          "scheme",
          "isin",
          "amfi",
          "type",
          "rta",
          "rta_code",
          "advisor",
          "open",
          "close",
          "close_calculated",
          "valuation",
          "transactions"
        ],
        "title": "Scheme",
        "type": "object"
      },
      "StatementError": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "enum": [
                  "not_a_pdf",
                  "password_required",
                  "incorrect_password",
                  "unrecognised_statement",
                  "unsupported_statement",
                  "parse_failed"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "file_too_large",
                  "already_imported",
                  "commit_failed"
                ],
                "type": "string"
              }
            ],
            "title": "Code"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "StatementError",
        "type": "object"
      },
      "StatementPeriod": {
        "properties": {
          "from": {
            "title": "From",
            "type": "string"
          },
          "to": {
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "title": "StatementPeriod",
        "type": "object"
      },
      "StatementPreview": {
        "properties": {
          "cas_type": {
            "enum": [
              "DETAILED",
              "SUMMARY"
            ],
            "title": "Cas Type",
            "type": "string"
          },
          "file_type": {
            "enum": [
              "CAMS",
              "KFINTECH"
            ],
            "title": "File Type",
            "type": "string"
          },
          "folios": {
            "items": {
              "$ref": "#/components/schemas/Folio"
            },
            "title": "Folios",
            "type": "array"
          },
          "parse_warnings": {
            "items": {
              "type": "string"
            },
            "title": "Parse Warnings",
            "type": "array"
          },
          "parser": {
            "$ref": "#/components/schemas/ParserInfo"
          },
          "statement_period": {
            "$ref": "#/components/schemas/StatementPeriod"
          }
        },
        "required": [
          "statement_period",
          "file_type",
          "cas_type",
          "folios",
          "parse_warnings",
          "parser"
        ],
        "title": "StatementPreview",
        "type": "object"
      },
      "Transaction": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "balance": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Balance"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "dividend_rate": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dividend Rate"
          },
          "nav": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nav"
          },
          "type": {
            "enum": [
              "PURCHASE",
              "PURCHASE_SIP",
              "REDEMPTION",
              "DIVIDEND_PAYOUT",
              "DIVIDEND_REINVEST",
              "SWITCH_IN",
              "SWITCH_IN_MERGER",
              "SWITCH_OUT",
              "SWITCH_OUT_MERGER",
              "STT_TAX",
              "STAMP_DUTY_TAX",
              "TDS_TAX",
              "SEGREGATION",
              "GIFT_IN",
              "GIFT_OUT",
              "MISC",
              "UNKNOWN",
              "REVERSAL"
            ],
            "title": "Type",
            "type": "string"
          },
          "units": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Units"
          }
        },
        "required": [
          "date",
          "description",
          "type",
          "amount",
          "units",
          "nav",
          "balance",
          "dividend_rate"
        ],
        "title": "Transaction",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Valuation": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "nav": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Nav",
            "type": "string"
          },
          "value": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "date",
          "nav",
          "cost",
          "value"
        ],
        "title": "Valuation",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Wealth Tracker",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health"
      }
    },
    "/api/imports": {
      "post": {
        "description": "Parse a statement PDF and add it to the ledger. The PDF itself is not kept.\n\nIf any Scheme's closing units disagree with the ledger, nothing is saved and the\nmismatches come back; commit again with a decision for each (ADR 0027).",
        "operationId": "commitImport",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_commitImport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "committed": "#/components/schemas/ImportReceipt",
                      "needs_decisions": "#/components/schemas/DecisionsRequired"
                    },
                    "propertyName": "outcome"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ImportReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/DecisionsRequired"
                    }
                  ],
                  "title": "Response Commitimport"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementError"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementError"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementError"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementError"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Commit Import"
      }
    },
    "/api/positions": {
      "get": {
        "operationId": "listPositions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PositionSummary"
                  },
                  "title": "Response Listpositions",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Positions"
      }
    },
    "/api/statements/preview": {
      "post": {
        "description": "Parse a statement PDF and return its contents. Nothing is stored.",
        "operationId": "previewStatement",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_previewStatement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementPreview"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementError"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementError"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Preview Statement"
      }
    }
  }
}
