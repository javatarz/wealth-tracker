{
  "components": {
    "schemas": {
      "AppraisalMark": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "instrument_id": {
            "format": "uuid",
            "title": "Instrument Id",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "value": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "instrument_id",
          "date",
          "value",
          "recorded_at"
        ],
        "title": "AppraisalMark",
        "type": "object"
      },
      "AppraisalRequest": {
        "description": "A user-supplied revaluation. Lax, because JSON carries dates and decimals as text.",
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "date",
          "value"
        ],
        "title": "AppraisalRequest",
        "type": "object"
      },
      "Body_commitImport": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "CAMS/KFintech consolidated account statement",
            "title": "File",
            "type": "string"
          },
          "password": {
            "default": "",
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_commitImport",
        "type": "object"
      },
      "Body_previewStatement": {
        "properties": {
          "file": {
